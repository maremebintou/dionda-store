{
  "name": "dionda-store",
  "version": "0.2.0",
  "private": true,
  "description": "DIONDA STORE — L'authenticité de nos terroirs, l'élégance du naturel. Boutique e-commerce de produits du terroir sénégalais et ouest-africain (prototype frontend, prêt pour un SaaS).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p . && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p .",
    "test": "bun test",
    "test:e2e": "python3 tests/e2e.py",
    "build:bun": "bun build.ts",
    "dev:bun": "bun --hot index.html"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
